NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# PostgreSQL (хост "db" — имя сервиса в docker compose)
POSTGRES_DB=max_helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change_me_long_random_password
DATABASE_URL=postgresql://helpdesk:change_me_long_random_password@db:5432/max_helpdesk?schema=public

# MAX
MAX_BOT_TOKEN=
# polling — по умолчанию (домен не нужен); webhook — нужен домен + HTTPS 443
MAX_MODE=polling
# Только для MAX_MODE=webhook: домен и секрет (5-256 символов [A-Za-z0-9_-])
MAX_WEBHOOK_DOMAIN=
MAX_WEBHOOK_SECRET=

# MAX user_id единственного superadmin (узнать: написать боту /myid)
SUPERADMIN_MAX_USER_ID=
